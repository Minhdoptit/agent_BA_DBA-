# ==============================================================================
# CẤU HÌNH CHO BA AI AGENT (ba-01) - Business Analyst
# ==============================================================================

# 1. Cấu hình mạng và dịch vụ
HOST=0.0.0.0
PORT=8003
AGENT_ID=ba-01
AGENT_ROLE=BA

# 2. Xác thực bảo mật Bearer Token
AGENT_API_KEY=your_secure_bearer_token_here
MAX_UPLOAD_MB=50

# 3. Kết nối liên agent (DBA Agent)
DBA_ENDPOINT=http://127.0.0.1:8004
DBA_API_KEY=dba-secret-token-key-2026-secure-32chars

# 4. Cấu hình Google Gemini API (để trống nếu dùng fallback offline)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# 5. Thư mục lưu trữ tài liệu đầu ra và không gian làm việc
ARTIFACT_DIR=./artifacts
WORKSPACE_DIR=./workspace
LOGS_DIR=./logs
