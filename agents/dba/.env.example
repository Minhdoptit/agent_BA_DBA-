# ==============================================================================
# CẤU HÌNH CHO DBA AI AGENT (dba-01) - Database Administrator
# ==============================================================================

# 1. Cấu hình mạng và dịch vụ
HOST=0.0.0.0
PORT=8004
AGENT_ID=dba-01
AGENT_ROLE=DBA

# 2. Xác thực bảo mật Bearer Token
AGENT_API_KEY=your_secure_bearer_token_here
MAX_UPLOAD_MB=50

# 3. Kết nối liên agent (BA Agent)
BA_ENDPOINT=http://127.0.0.1:8003
BA_API_KEY=ba-secret-token-key-2026-secure-32chars

# 4. Kết nối trung chuyển tới PM Agent (pm-01 trên Máy 1)
PM_ENDPOINT=http://127.0.0.1:8001
PM_API_KEY=pm-secret-token-key-2026-secure-32chars

# 4. Cấu hình Google Gemini API (để trống nếu dùng fallback offline)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60

# 5. Cấu hình Cơ sở dữ liệu mục tiêu
DATABASE_DIALECT=postgresql
DATABASE_VERSION=16

# 6. Thư mục lưu trữ tài liệu đầu ra và không gian làm việc
ARTIFACT_DIR=./artifacts
WORKSPACE_DIR=./workspace
LOGS_DIR=./logs
